# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real a GitHub ni lo compartas.
#
# Este proyecto corre como DOS servidores separados (ver README):
#   ROLE=public → el sitio que ve todo el mundo, sin panel de edición.
#   ROLE=admin  → el panel que usan Diego y Graciela, que publica los
#                 cambios en el servidor público.
# En Railway, cada uno es un servicio distinto con sus propias variables.
# Para correrlos localmente, usa "npm run start:public" o "npm run start:admin"
# (cada uno ignora las variables que no le corresponden).

PORT=3000
ROLE=public

# --- Servidor público (ROLE=public) ---
# Secreto compartido para aceptar cambios que vengan del servidor admin.
# Genera uno largo y al azar, por ejemplo con: openssl rand -hex 32
SYNC_SECRET=

# --- Servidor admin (ROLE=admin) ---
# Clave para entrar al panel.
ADMIN_PASSWORD=cambia-esta-clave
# Mismo valor que el SYNC_SECRET del servidor público.
# SYNC_SECRET=
# URL pública del servidor público (sin "/" al final), ej:
# PUBLIC_SITE_URL=https://matronalactancia.up.railway.app
PUBLIC_SITE_URL=
